PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wishify?schema=public

JWT_ACCESS_SECRET=wishify_super_secret_access_key_2026_jwt_token_auth
JWT_REFRESH_SECRET=wishify_super_secret_refresh_key_2026_jwt_token_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay (Leave blank for mock payment mode in development)
RAZORPAY_KEY_ID=rzp_test_wishify_sample_key
RAZORPAY_KEY_SECRET=wishify_sample_secret_key

# Cloudinary (Leave blank for mock image upload fallback)
CLOUDINARY_CLOUD_NAME=wishify-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345

# Firebase (Leave blank for mock notification logging)
FIREBASE_PROJECT_ID=wishify-gifting
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@wishify-gifting.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

CORS_ORIGIN=*

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
  WALLET
  UPI_QR
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum SlotType {
  EARLY_MORNING
  STANDARD
  FIXED_TIME
  MIDNIGHT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model User {
  id              String         @id @default(uuid())
  phone           String?        @unique
  email           String?        @unique
  name            String?
  role            Role           @default(CUSTOMER)
  passwordHash    String?
  isPhoneVerified Boolean        @default(false)
  isActive        Boolean        @default(true)
  walletBalance   Float          @default(0.0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  addresses       Address[]
  orders          Order[]
  cart            Cart?
  reviews         Review[]
  wishlists       Wishlist[]
  reminders       Reminder[]
  notifications   Notification[]
  deviceTokens    DeviceToken[]
  statusUpdates   OrderStatusHistory[]

  @@map("users")
}

model Address {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  latitude     Float?
  longitude    Float?
  addressType  AddressType @default(HOME)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orders       Order[]

  @@map("addresses")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products    Product[]

  @@map("categories")
}

model Occasion {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  bannerUrl   String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("occasions")
}

model Product {
  id                    String           @id @default(uuid())
  title                 String
  slug                  String           @unique
  description           String
  categoryId            String
  category              Category         @relation(fields: [categoryId], references: [id])
  occasionId            String?
  occasion              Occasion?        @relation(fields: [occasionId], references: [id])
  basePrice             Float
  compareAtPrice        Float?
  isVegetarian          Boolean          @default(true)
  isPersonalized        Boolean          @default(false)
  personalizationPrompt String?
  isSameDayEligible     Boolean          @default(true)
  isMidnightEligible    Boolean          @default(true)
  isActive              Boolean          @default(true)
  averageRating         Float            @default(5.0)
  reviewCount           Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  variants              ProductVariant[]
  images                ProductImage[]
  addOns                AddOn[]          @relation("ProductAddOns")
  reviews               Review[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  wishlists             Wishlist[]

  @@map("products")
}

model ProductVariant {
  id             String      @id @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String
  price          Float
  compareAtPrice Float?
  sku            String      @unique
  stockQuantity  Int         @default(100)
  weightOrSize   String?
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@map("product_variants")
}

model AddOn {
  id            String           @id @default(uuid())
  title         String
  description   String?
  price         Float
  imageUrl      String?
  stockQuantity Int              @default(100)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  products      Product[]        @relation("ProductAddOns")
  cartItemAddOns CartItemAddOn[]
  orderItemAddOns OrderItemAddOn[]

  @@map("add_ons")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String
  deepLink  String?
  position  String   @default("HOME_TOP")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  description       String?
  discountType      DiscountType @default(PERCENTAGE)
  discountValue     Float
  minOrderValue     Float        @default(0.0)
  maxDiscountAmount Float?
  validFrom         DateTime     @default(now())
  validTo           DateTime
  usageLimit        Int          @default(1000)
  usedCount         Int          @default(0)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  orders            Order[]

  @@map("coupons")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id                  String          @id @default(uuid())
  cartId              String
  cart                Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId           String
  product             Product         @relation(fields: [productId], references: [id])
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id])
  quantity            Int             @default(1)
  personalizationText String?
  deliveryDate        DateTime?
  deliverySlotId      String?
  deliverySlot        DeliverySlot?   @relation(fields: [deliverySlotId], references: [id])
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  addOns              CartItemAddOn[]

  @@map("cart_items")
}

model CartItemAddOn {
  id         String   @id @default(uuid())
  cartItemId String
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  addOnId    String
  addOn      AddOn    @relation(fields: [addOnId], references: [id])
  quantity   Int      @default(1)

  @@unique([cartItemId, addOnId])
  @@map("cart_item_add_ons")
}

model Order {
  id                   String               @id @default(uuid())
  orderNumber          String               @unique
  userId               String
  user                 User                 @relation(fields: [userId], references: [id])
  addressId            String
  address              Address              @relation(fields: [addressId], references: [id])
  subtotal             Float
  deliveryFee          Float                @default(0.0)
  discountAmount       Float                @default(0.0)
  taxAmount            Float                @default(0.0)
  totalAmount          Float
  couponCode           String?
  couponId             String?
  coupon               Coupon?              @relation(fields: [couponId], references: [id])
  orderStatus          OrderStatus          @default(PLACED)
  paymentStatus        PaymentStatus        @default(PENDING)
  paymentMethod        PaymentMethod        @default(RAZORPAY)
  deliveryDate         DateTime
  deliverySlotId       String
  deliverySlot         DeliverySlot         @relation(fields: [deliverySlotId], references: [id])
  recipientName        String
  recipientPhone       String
  giftMessage          String?
  isSenderHidden       Boolean              @default(false)
  deliveryPartnerName  String?
  deliveryPartnerPhone String?
  trackingNumber       String?
  cancelReason         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  payments             Payment[]

  @@map("orders")
}

model OrderItem {
  id                  String           @id @default(uuid())
  orderId             String
  order               Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product          @relation(fields: [productId], references: [id])
  variantId           String?
  variant             ProductVariant?  @relation(fields: [variantId], references: [id])
  title               String
  variantTitle        String?
  unitPrice           Float
  quantity            Int
  totalPrice          Float
  personalizationText String?
  imageUrl            String?

  addOns              OrderItemAddOn[]

  @@map("order_items")
}

model OrderItemAddOn {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addOnId     String
  addOn       AddOn     @relation(fields: [addOnId], references: [id])
  title       String
  unitPrice   Float
  quantity    Int
  totalPrice  Float

  @@map("order_item_add_ons")
}

model OrderStatusHistory {
  id              String      @id @default(uuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          OrderStatus
  notes           String?
  updatedByUserId String?
  updatedByUser   User?       @relation(fields: [updatedByUserId], references: [id])
  createdAt       DateTime    @default(now())

  @@map("order_status_history")
}

model Payment {
  id                   String        @id @default(uuid())
  orderId              String
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId            String?       @unique
  transactionReference String?
  amount               Float
  currency             String        @default("INR")
  status               PaymentStatus @default(PENDING)
  gateway              String        @default("RAZORPAY")
  rawPayload           Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("payments")
}

model Review {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

model Reminder {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occasionTitle    String
  recipientName    String
  eventDate        DateTime
  remindDaysBefore Int      @default(2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("reminders")
}

model Pincode {
  id                   String   @id @default(uuid())
  code                 String   @unique
  city                 String
  state                String
  isServiceable        Boolean  @default(true)
  isSameDayAvailable   Boolean  @default(true)
  isMidnightAvailable  Boolean  @default(true)
  standardDeliveryFee  Float    @default(0.0)
  midnightDeliveryFee  Float    @default(250.0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("pincodes")
}

model DeliverySlot {
  id                 String     @id @default(uuid())
  title              String
  slotType           SlotType   @default(STANDARD)
  startTime          String
  endTime            String
  fee                Float      @default(0.0)
  cutoffHoursBefore  Int        @default(2)
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  cartItems          CartItem[]
  orders             Order[]

  @@map("delivery_slots")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("ORDER_UPDATE")
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("ANDROID")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("device_tokens")
}

model PaymentSetting {
  id                String   @id @default(uuid())
  upiId             String   @default("wishify@upi")
  qrImageUrl        String   @default("https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=upi://pay?pa=wishify@upi&pn=Wishify&cu=INR")
  accountHolderName String   @default("Wishify Gifts")
  codMaxAmount      Float    @default(100.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("payment_settings")
}
